<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Sin ACCESS_BACKGROUND_LOCATION a propósito: la ubicación solo se usa
         en primer plano, para evitar la revisión estricta de Google Play
         sobre permisos de ubicación en segundo plano (ver documento técnico, sección 5). -->

    <application
        android:name=".TuGymBroApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TuGymBro">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TuGymBro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
